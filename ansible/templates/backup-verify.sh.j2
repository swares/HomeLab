#!/bin/bash
# {{ ansible_managed | default('Managed by Ansible — do not edit by hand') }}
#
# Weekly verification that the backups are not merely running, but real.
#
# This exists because three separate mechanisms in this lab were found reporting
# success while doing nothing (2026-07-24 review, docs/REVIEW-2026-07-24.md):
#   - backup-etcd snapshotted a SQLite file that no longer existed, producing
#     4 KB files and pinging healthchecks.io green for a month;
#   - backup-offsite rendered to a no-op that logged "skipping" and exited 0;
#   - backup-cloud's retention never deleted anything because a random staging
#     path put every snapshot in its own retention group.
# In every case the *job* was healthy and the *outcome* was not. This script
# checks outcomes.
#
# It is read-only. It never writes to, forgets from, or prunes any repository.
#
# NOTE FOR EDITORS: this is a Jinja2 template. Do not use bash's array-length
# syntax (dollar-brace-hash-name); brace followed by hash opens a Jinja comment.

set -uo pipefail   # NOT -e: we want every check to run, then report all failures

PRIMARY={{ restic_repo | quote }}
COPY={{ restic_copy_repo | quote }}
PW={{ restic_password_file | quote }}
CLOUD_ENV={{ cloud_env_file | quote }}
ETCD_DIR={{ etcd_snapshot_dest | quote }}
# Offsite (R2 homelab-nas). Written by backup-offsite.yml, which is a separate
# playbook because it needs a Vault token; these paths are duplicated in
# backup.yml's vars so this template can be rendered without it.
OFFSITE_ENV={{ offsite_env_file | quote }}
OFFSITE_PW={{ offsite_password_file | quote }}

failures=0
fail() { echo "FAIL: $*" >&2; failures=$((failures + 1)); }
pass() { echo "ok:   $*"; }

# ---- 1. Structural integrity of the two local repos ------------------------
for repo in "$PRIMARY" "$COPY"; do
  if restic -r "$repo" --password-file "$PW" check > /tmp/verify-check.$$ 2>&1; then
    pass "restic check clean — $repo"
  else
    fail "restic check FAILED — $repo"
    sed 's/^/        /' /tmp/verify-check.$$ >&2
  fi
  rm -f /tmp/verify-check.$$
done

# ---- 2. The two local repos should both have a recent snapshot -------------
# The copy legitimately holds MORE snapshots than the primary (deeper retention),
# so we compare recency, not counts.
for repo in "$PRIMARY" "$COPY"; do
  latest_epoch=$(restic -r "$repo" --password-file "$PW" snapshots --tag nas --json 2>/dev/null \
    | tr ',' '\n' | grep -o '"time":"[^"]*"' | tail -1 | cut -d'"' -f4 \
    | xargs -r -I{} date -d {} +%s 2>/dev/null)
  if [ -z "${latest_epoch:-}" ]; then
    fail "could not determine newest 'nas' snapshot in $repo"
  else
    age=$(( $(date +%s) - latest_epoch ))
    if [ "$age" -gt {{ verify_max_snapshot_age_seconds }} ]; then
      fail "newest 'nas' snapshot in $repo is ${age}s old (max {{ verify_max_snapshot_age_seconds }}s)"
    else
      pass "newest 'nas' snapshot in $repo is ${age}s old"
    fi
  fi
done

# ---- 2b. lldap has a recent snapshot too -----------------------------------
# Added 2026-08-28. Every freshness check above filters `--tag nas`, so for as
# long as this script has existed it has verified the NAS stream and said nothing
# about the identity database sharing the same repository. §1.12 was diagnosed
# three times without this check existing to contradict it.
# THE COPY LAGS BY A FULL DAY, BY CONSTRUCTION. Corrected 2026-08-29, the same day
# this check was written, before it ever cried wolf.
#
# lldap writes at 02:30. backup-nas copies to cold-sec at 01:30. So the newest lldap
# snapshot reaching the copy is already ~23h old when it arrives, then ages another
# 24h before the next copy — a peak of ~47h against the 48h NAS threshold. One hour
# of margin, on a host where docs/BACKUP-RESTORE.md records backup-nas taking hours
# during a large Immich import. It would have failed on a perfectly healthy system,
# at whatever hour the weekly verify timer happened to land.
#
# The `nas` check above needs no such allowance: those snapshots are created at
# 01:30 and copied in the same run, seconds apart — the live run showed 44620s on
# the primary against 44621s on the copy.
for repo in "$PRIMARY" "$COPY"; do
  if [ "$repo" = "$COPY" ]; then
    max_age={{ verify_max_snapshot_age_seconds + 86400 }}   # + one copy cycle
  else
    max_age={{ verify_max_snapshot_age_seconds }}
  fi
  latest_epoch=$(restic -r "$repo" --password-file "$PW" snapshots --tag {{ lldap_snapshot_tag }} --json 2>/dev/null \
    | tr ',' '\n' | grep -o '"time":"[^"]*"' | tail -1 | cut -d'"' -f4 \
    | xargs -r -I{} date -d {} +%s 2>/dev/null)
  if [ -z "${latest_epoch:-}" ]; then
    fail "could not determine newest '{{ lldap_snapshot_tag }}' snapshot in $repo"
  else
    age=$(( $(date +%s) - latest_epoch ))
    if [ "$age" -gt "$max_age" ]; then
      fail "newest '{{ lldap_snapshot_tag }}' snapshot in $repo is ${age}s old (max ${max_age}s)"
    else
      pass "newest '{{ lldap_snapshot_tag }}' snapshot in $repo is ${age}s old (max ${max_age}s)"
    fi
  fi
done

# ---- 2c. No snapshot group escapes retention -------------------------------
# Added 2026-08-28 alongside scoping the forget commands (BACKLOG §1.12).
#
# Retention is now expressed as two scoped rules per repo: `--tag nas --host
# h4-core` and `--tag lldap --host lldap-k8s`. That is strictly safer than the
# unscoped policy it replaces, except in one direction: a snapshot group matching
# NEITHER rule is now never forgotten. It would grow forever, in the repository
# that is the copy-of-record for the cold tier, and nothing else would notice.
#
# The likeliest cause is a cross-repo rename — gitops/workloads/lldap/backup-
# cronjob.yaml changing its `--tag` or `--host` without ansible/playbooks/backup.yml
# following. A comment cannot enforce that. This can.
#
# Read-only: it lists, it does not forget.
EXPECTED_GROUPS="{{ inventory_hostname }}|{{ nas_snapshot_tag }}
{{ lldap_snapshot_host }}|{{ lldap_snapshot_tag }}"

for repo in "$PRIMARY" "$COPY"; do
  groups=$(restic -r "$repo" --password-file "$PW" snapshots --json 2>/dev/null \
    | python3 -c 'import json,sys
for s in json.load(sys.stdin):
    for t in (s.get("tags") or ["<untagged>"]):
        print(s.get("hostname","<nohost>") + "|" + t)' 2>/dev/null | sort -u)

  # An empty list is NOT "no unexpected groups". Both repos are known to hold
  # snapshots, so empty means restic failed, the password was wrong, or the JSON
  # did not parse — and reporting a pass there would be the exact fault this
  # script exists to catch. Silence is treated as failure to verify.
  if [ -z "$groups" ]; then
    fail "could not enumerate snapshot groups in $repo — retention coverage UNVERIFIED"
    continue
  fi

  unknown=0
  while IFS= read -r grp; do
    [ -z "$grp" ] && continue
    if ! printf '%s\n' "$EXPECTED_GROUPS" | grep -qxF "$grp"; then
      fail "unretained snapshot group '$grp' in $repo — matches no forget rule, will be kept forever"
      unknown=1
    fi
  done <<< "$groups"

  if [ "$unknown" -eq 0 ]; then
    pass "all $(printf '%s\n' "$groups" | wc -l) snapshot group(s) in $repo are covered by a retention rule"
  fi
done

# ---- 3. Cold etcd snapshots are real, not the 4 KB ghosts ------------------
newest_etcd=$(ls -1t -- "$ETCD_DIR"/etcd-snapshot-* 2>/dev/null | head -n 1)
if [ -z "$newest_etcd" ]; then
  fail "no etcd-snapshot-* files in $ETCD_DIR"
else
  etcd_size=$(stat -c %s -- "$newest_etcd")
  if [ "$etcd_size" -lt {{ etcd_snapshot_min_bytes }} ]; then
    fail "newest etcd snapshot is only ${etcd_size} bytes — the empty-file bug is back"
  else
    pass "newest etcd snapshot $(basename "$newest_etcd") is ${etcd_size} bytes"
  fi
fi

# ---- 4. R2: integrity, and that it actually contains cluster state ---------
# The content assertion is the important half. A clean `check` only proves the
# repo is well-formed; it says nothing about whether the right files are in it.
# backup-cloud sources /mnt/cold-8t/k3s-etcd-snapshots, so if that directory were
# ever wrong again, R2 would faithfully back up the wrong thing and still pass.
if [ ! -r "$CLOUD_ENV" ]; then
  echo "warn: $CLOUD_ENV not present — skipping R2 checks (run backup-cloud.yml?)" >&2
else
  # shellcheck disable=SC1090
  set -a; . "$CLOUD_ENV"; set +a

  if restic check > /tmp/verify-cloud.$$ 2>&1; then
    pass "restic check clean — R2"
  else
    fail "restic check FAILED — R2"
    sed 's/^/        /' /tmp/verify-cloud.$$ >&2
  fi
  rm -f /tmp/verify-cloud.$$

  # List the whole snapshot ONCE, then match with path-anchored patterns.
  #
  # Deliberately NOT using restic's directory-filter form (`restic ls latest <dir>`).
  # Current restic documents it, but 0.12.1 — what the H4 runs — does not behave the
  # same way: on 2026-07-25 the filtered form reported the k3s server token missing
  # from a snapshot that demonstrably contained it, while the unfiltered listing
  # found it immediately. Anchoring the grep to the full path gives the same
  # precision without depending on version-specific filter semantics.
  # These cloud snapshots are small (hundreds of entries), so listing all is cheap.
  cloud_listing=$(mktemp)
  restic ls latest > "$cloud_listing" 2>/dev/null || true

  etcd_in_cloud=$(grep -c "^${ETCD_DIR}/etcd-snapshot-" "$cloud_listing" || true)
  if [ "${etcd_in_cloud:-0}" -lt 1 ]; then
    fail "newest R2 snapshot contains NO etcd-snapshot-* files under $ETCD_DIR"
  else
    pass "newest R2 snapshot contains ${etcd_in_cloud} etcd-snapshot-* files"
  fi

  # The k3s server token must be in the backup or the etcd snapshots above cannot
  # be restored onto new hardware — k3s derives the datastore's encryption key
  # from it. Until 2026-07-25 it was backed up nowhere.
  if grep -q "^{{ cloud_stage_dir }}/k3s-server-token$" "$cloud_listing"; then
    pass "newest R2 snapshot contains the k3s server token"
  else
    fail "newest R2 snapshot has NO k3s server token — etcd snapshots are unrestorable on new hardware"
  fi

  rm -f "$cloud_listing"

  cloud_count=$(restic snapshots --tag cloud --json 2>/dev/null | grep -o '"time":' | wc -l)
  echo "info: R2 holds ${cloud_count} cloud snapshots"
fi

# ---- 5. Offsite R2 (homelab-nas): integrity and recency --------------------
# Added 2026-08-11, once the ~204 GiB initial seed completed. Until then this was
# the ONLY repo with no weekly check — and it is the one tier that exists
# specifically to survive losing the H4. Checking it against a half-populated repo
# would only have produced noise, which is why it waited for the seed.
#
# Every restic call names its repo and password file explicitly. Section 4 exports
# RESTIC_REPOSITORY and RESTIC_PASSWORD_FILE for the *cloud* repo and they are
# still set here; the flags take precedence over the environment, so this cannot
# silently check the wrong repository. Do not "simplify" this by relying on the
# env — that is exactly how you end up verifying one repo twice and another never.
if [ ! -r "$OFFSITE_ENV" ]; then
  echo "warn: $OFFSITE_ENV not present — skipping offsite checks (run backup-offsite.yml?)" >&2
elif [ ! -r "$OFFSITE_PW" ]; then
  echo "warn: $OFFSITE_PW not present — skipping offsite checks" >&2
else
  # shellcheck disable=SC1090
  set -a; . "$OFFSITE_ENV"; set +a
  OFFSITE_REPO="${RESTIC_REPOSITORY_OFFSITE:-}"

  if [ -z "$OFFSITE_REPO" ]; then
    fail "RESTIC_REPOSITORY_OFFSITE is empty in $OFFSITE_ENV — offsite is not configured"
  else
    # Structural check only, no --read-data: re-reading 204 GiB from R2 weekly
    # would cost hours and (on a metered link) real money. This verifies indexes
    # and pack metadata, which is what catches a corrupt or truncated upload.
    if restic -r "$OFFSITE_REPO" --password-file "$OFFSITE_PW" check \
         > /tmp/verify-offsite.$$ 2>&1; then
      pass "restic check clean — offsite R2"
    else
      fail "restic check FAILED — offsite R2"
      sed 's/^/        /' /tmp/verify-offsite.$$ >&2
    fi
    rm -f /tmp/verify-offsite.$$

    # Recency. backup-offsite copies daily at 02:30; this runs weekly on Sunday,
    # so anything older than the shared threshold means the copy has stopped.
    # Same tag/parse approach as section 2 — see the note there about 0.12.1.
    offsite_epoch=$(restic -r "$OFFSITE_REPO" --password-file "$OFFSITE_PW" \
        snapshots --tag nas --json 2>/dev/null \
      | tr ',' '\n' | grep -o '"time":"[^"]*"' | tail -1 | cut -d'"' -f4 \
      | xargs -r -I{} date -d {} +%s 2>/dev/null)
    if [ -z "${offsite_epoch:-}" ]; then
      fail "could not determine newest 'nas' snapshot in offsite R2"
    else
      offsite_age=$(( $(date +%s) - offsite_epoch ))
      if [ "$offsite_age" -gt {{ verify_max_snapshot_age_seconds }} ]; then
        fail "newest 'nas' snapshot offsite is ${offsite_age}s old (max {{ verify_max_snapshot_age_seconds }}s)"
      else
        pass "newest 'nas' snapshot offsite is ${offsite_age}s old"
      fi
    fi

    # grep -o | wc -l, not grep -c: `snapshots --json` is one line, so grep -c
    # would report 1 for any non-empty repo. Cost the offsite job a meaningless
    # "1 snapshots at destination" on 2026-08-11.
    offsite_count=$(restic -r "$OFFSITE_REPO" --password-file "$OFFSITE_PW" \
        snapshots --json 2>/dev/null | grep -o '"short_id"' | wc -l)
    echo "info: offsite R2 holds ${offsite_count} snapshots"
  fi
fi

# ---- Verdict ----------------------------------------------------------------
if [ "$failures" -gt 0 ]; then
  echo "backup-verify: ${failures} check(s) FAILED" >&2
  exit 1
fi
echo "backup-verify: all checks passed"
