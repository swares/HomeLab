# Pre-seeded Pi-hole v6 config (Ansible-managed). Its presence is what lets the installer
# honour --unattended on a fresh host. FTL fills every unset key with its default.
# For a full reference: install once, configure to taste, then copy the resulting
# /etc/pihole/pihole.toml back here as the template.
[dns]
  domain = "{{ lab_domain }}"
  expandHosts = true
  upstreams = [{% for u in dns_upstream %}"{{ u }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  # Static node records (A + auto-generated PTR for the reverse zone)
  hosts = [{% for name, ip in dns_records.items() %}"{{ ip }} {{ name }}.{{ lab_domain }}"{% if not loop.last %}, {% endif %}{% endfor %}]

[misc]
  # Kubernetes ingress wildcard, injected as a raw dnsmasq directive (v6-native way):
  dnsmasq_lines = ["address=/apps.{{ lab_domain }}/{{ ingress_vip }}"]
  # also parse user drop-ins in /etc/dnsmasq.d/ (optional extras / bare-dnsmasq parity)
  etc_dnsmasq_d = true

[webserver.api]
  # BACKLOG §2.1. This block previously read:
  #   password = "{{ '{{' }} pihole_web_password_hash | default('') {{ '}}' }}"
  # Two defects in one line. `password` is v6's *plaintext* setup field, not the
  # hash field — FTL consumes it and writes `pwhash`. And the value it expected was
  # a double-sha256 hash, which is v5's scheme (WEBPASSWORD in setupVars.conf).
  # The variable was empty everywhere in the repo, so this rendered no admin auth.
  #
  # `pwhash` is the v6 hash field. Format is BALLOON-SHA256, generated by
  # `pihole setpassword <password>` on a Pi-hole host; copy the resulting value
  # out of /etc/pihole/pihole.toml into Vault at secret/lab/pihole web-pwhash.
  # No default here on purpose: dns.yml asserts the hash is present and correctly
  # shaped before rendering, so an unauthenticated UI cannot be deployed by an
  # unset variable the way it was for months.
  pwhash = "{{ pihole_web_pwhash }}"
