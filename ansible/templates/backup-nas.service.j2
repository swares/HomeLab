[Unit]
Description=restic backup of live NAS data (8TB primary) + copy to 6TB secondary
RequiresMountsFor={{ cold_primary_mount }} {{ cold_secondary_mount }} {{ nas_mount }}

# Trigger the offsite copy as soon as THIS unit succeeds, instead of hoping an hour
# of clock separation is enough. BACKLOG §1.9.
#
# Both jobs need the primary repo's lock. restic holds it for the whole operation, so
# whichever starts second fails outright with:
#     unable to create lock in backend: repository is already locked by PID …
# That is what cost four consecutive nights of backups on 08–11 Aug, when a three-day
# offsite seed starved the nightly run.
#
# Bounding the offsite copy to 4h fixed that direction. The REVERSE was still
# unguarded: this unit normally finishes in ~10s, but docs/BACKUP-RESTORE.md notes a
# large Immich import can push it to hours — and a run still holding the lock at 02:30
# fails the offsite copy with the identical error. Scheduling cannot fix that, because
# neither job knows how long the other will take.
#
# OnSuccess= puts them in one transaction, which is also what finally makes
# backup-offsite.service's `After=backup-nas.service` mean something: ordering
# directives only apply within a transaction, so until now that line was decorative.
#
# Consequence, deliberately accepted: the offsite copy no longer runs when this unit
# FAILS. That is correct — copying a repository that just failed to update has little
# value — but it means one root cause raises two alarms, this unit's and the offsite
# healthchecks.io check going silent. Two alerts for one cause beats a silent gap.
#
# Requires systemd >= 249 (Ubuntu 22.04 ships 249). Verify with `systemd --version`
# and `systemctl show backup-nas.service -p OnSuccess` before trusting the chain.
OnSuccess=backup-offsite.service

[Service]
Type=oneshot
# restic caches pack and index metadata under $RESTIC_CACHE_DIR. Without one it
# re-reads every index on each run:
#   warning: running prune without a cache, this may be very slow!
# Harmless at 203 GiB / 43k packs today (prune finishes in ~3s), but it scales
# with repository size, not with how much changed. systemd creates and owns
# /var/cache/restic via CacheDirectory=; restic namespaces by repository ID
# inside it, so every backup unit can share the one directory.
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic
Environment=RESTIC_REPOSITORY={{ restic_repo }}
Environment=RESTIC_PASSWORD_FILE={{ restic_password_file }}
# Initialize the primary repo once if needed, then back up.
ExecStartPre=-/usr/bin/restic init
# {{ cold_primary_mount }}/VMs REMOVED 2026-08-13. It held exactly one file —
# YIKW.VHDX, 224.7 GiB, the HTPC's Windows disk image, unchanged since 2026-06-18 —
# and that is 99.9% of everything this job was backing up. Total File Count for the
# whole snapshot was 35.
#
# It is recreatable from installation media, so it does not warrant 224 GiB of
# offsite storage (~$3/month of the R2 bill) or the three days the initial seed
# spent uploading it. /srv/nas and the immich library are both still empty pending
# migration, which is why the repository looked large and was almost entirely inert.
#
# Restore it by hand from a snapshot older than this change if it is ever wanted.
#
# CORRECTION 2026-08-29: the line here used to end "retention keeps monthlies for
# 6 months", which is wrong, and wrong in the direction that matters. Dropping a
# path from this ExecStart starts a NEW retention series, because restic groups by
# host+paths. The old path set becomes a frozen group with no new snapshots — and
# `--keep-daily 7` keeps the seven most recent days *that have snapshots*, not the
# last seven calendar days. A frozen group therefore has its entire tail preserved
# indefinitely, not aged out.
#
# Measured with `forget --dry-run` on 2026-08-29: all 13 VMs-era snapshots are
# kept — 2 in the `VMs + /srv/nas` group and 11 in `VMs + immich + /srv/nas` —
# because the union of daily-7, weekly-4 and monthly-6 covers every distinct day
# those frozen groups contain.
#
# So removing the path stopped new copies and freed nothing. The 224.7 GiB image
# still sits in the primary, in cold-sec, and in R2, and will remain there until
# somebody forgets those groups deliberately. The ~$3/month it was removed to stop
# paying is still being paid. See BACKLOG §1.10 — reclaiming it is an irreversible
# deletion of the only copies of that image, so it is a decision, not a cleanup.
#
# The same mechanism is why lldap's July snapshots looked dense while its live
# group was being thinned (§1.12). Changing a backup's path list is a retention
# event, and nothing in this lab announces it.
# /var/lib/lab-ledger added 2026-08-27 — on the eMMC root (/dev/mmcblk0p2), NOT the
# NVMe; /var is part of the OS filesystem. The lab ledger (docs/LEDGER-DESIGN.md) is
# append-only JSONL of timestamped facts — what changed, when, on which host. It
# is kilobytes a day and it is the ONLY record designed to outlive Loki's 30d and
# Prometheus's ~14d actual retention (BACKLOG §3.14).
#
# Backing it up here rather than giving it its own restic repo is deliberate: it
# rides the existing chain to both cold mirrors and offsite, adds nothing to the
# rotation, and touches neither the NAS data nor the cold disks directly — both
# of which CLAUDE.md puts off-limits.
#
# The irony is the argument: a ledger that records backup outcomes and is not
# itself backed up would be the first thing lost in the incident it exists to
# explain.
ExecStart=/usr/bin/restic backup {{ nas_mount }} \
  {{ cold_primary_mount }}/immich \
  /var/lib/lab-ledger \
  --tag nas --host {{ inventory_hostname }}
# Retention is policy-driven and lives HERE only — never run forget/prune by hand.
#
# SCOPED 2026-08-28 (BACKLOG §1.12). This was one unscoped command:
#
#   ExecStartPost=/usr/bin/restic forget --prune \
#     --keep-daily 7 --keep-weekly 4 --keep-monthly 6
#
# restic's default grouping is host,paths, so that applied the NAS policy to EVERY
# group in the repository. The lldap CronJob writes the identity database to this
# same repo at 02:30; this ran at 01:30 and thinned it nightly. The survivors —
# dailies for a week, then one per week — were read as an intermittently failing
# backup job, three separate times, across two days of investigation. The job had
# never failed.
#
# Two scoped forgets, then ONE prune. Pruning is the expensive part and there is no
# reason to do it twice; systemd runs ExecStartPost lines in order, so the prune
# sees both forgets' work.
#
# The scoping is only safe because the repository contains exactly these two groups
# — verified 2026-08-28: 23 h4-core/nas, 25 lldap-k8s/lldap, nothing else. A group
# matching neither rule would never be forgotten again. backup-verify checks for
# that condition weekly rather than trusting this comment to stay true.
ExecStartPost=/usr/bin/restic forget --tag {{ nas_snapshot_tag }} --host {{ inventory_hostname }} \
  --keep-daily 7 --keep-weekly 4 --keep-monthly 6
ExecStartPost=/usr/bin/restic forget --tag {{ lldap_snapshot_tag }} --host {{ lldap_snapshot_host }} \
  --keep-daily {{ lldap_keep_daily }} --keep-weekly {{ lldap_keep_weekly }} --keep-monthly {{ lldap_keep_monthly }}
ExecStartPost=/usr/bin/restic prune
# Redundancy: replicate the primary repo to the 6TB disk (two-disk safety, no RAID
# needed), then bound the copy's retention. Deliberately NOT prefixed with '-' —
# a failed replication must fail this unit so hc-ping is skipped and
# healthchecks.io alerts. The script also picks the copy syntax matching the
# installed restic version; see its header for why that matters.
ExecStartPost=/usr/local/sbin/backup-nas-copy.sh
